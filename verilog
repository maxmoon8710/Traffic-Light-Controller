module TrafficLightController(clk, B, G1, A1, R1, G2, A2, R2);

    // 1. Inputs and Outputs
    input clk;        // The clock signal (e.g., from your 555 timer)
    input B;          // The pedestrian button
    
    output G1, A1, R1; // Main Road LEDs
    output G2, A2, R2; // Cross Road LEDs

    // 2. State Memory (The D-Flip-Flops)
    // We use 'reg' here because these variables store data across clock cycles.
    reg Q1;
    reg Q0;

    // Optional: Set default starting state for simulation purposes
    initial begin
        Q1 = 1'b0;
        Q0 = 1'b0;
    end

    // 3. Next State Combinational Logic
    // These calculate where the state machine should go next based on current state and button.
    wire Q1_next = Q1 ^ Q0;               // XOR gate
    wire Q0_next = ~Q0 & (Q1 | B);        // OR gate feeding into an AND gate

    // 4. State Update (Sequential Logic)
    // This block triggers ONLY when the clock goes from LOW to HIGH.
    always @(posedge clk) begin
        Q1 <= Q1_next;  // Non-blocking assignment updates flip-flops simultaneously
        Q0 <= Q0_next;
    end

    // 5. Output Combinational Logic (The LEDs)
    // These continuously drive the LEDs based ONLY on the current state.
    assign G1 = ~Q1 & ~Q0;
    assign A1 = ~Q1 & Q0;
    assign R1 = Q1;
    
    assign G2 = Q1 & ~Q0;
    assign A2 = Q1 & Q0;
    assign R2 = ~Q1;

endmodule

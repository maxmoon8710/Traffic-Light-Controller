module Main(clk_0);
 input clk_0;
 wire Button_0_out, DflipFlop_2_Q, DflipFlop_2_Q_inv, and_3_out, and_1_out,
DflipFlop_1_Q, DflipFlop_1_Q_inv, and_2_out, or_0_out, and_0_out, DflipFlop_0_Q,
DflipFlop_0_Q_inv, not_0_out, Power_0_out, Ground_0_out;
 Button0 Button_0(Button_0_out);
 DflipFlop DflipFlop_2(DflipFlop_2_Q, DflipFlop_2_Q_inv, clk_0, Button_0_out,
Ground_0_out, Ground_0_out, Power_0_out);
 assign and_3_out = DflipFlop_2_Q_inv & and_2_out;

 always @ (*)
 $display("DigitalLed:G1=%d", and_3_out);

 always @ (*)
 $display("DigitalLed:A1=%d", DflipFlop_2_Q);
 assign and_1_out = not_0_out & DflipFlop_2_Q;
 DflipFlop DflipFlop_1(DflipFlop_1_Q, DflipFlop_1_Q_inv, clk_0, and_1_out, Ground_0_out,
Ground_0_out, Power_0_out);
 assign and_2_out = DflipFlop_0_Q_inv & DflipFlop_1_Q_inv;

 always @ (*)
 $display("DigitalLed:R2=%d", and_2_out);

 always @ (*)
 $display("DigitalLed:G2=%d", DflipFlop_1_Q);
 assign or_0_out = DflipFlop_0_Q | DflipFlop_1_Q;

 always @ (*)
 $display("DigitalLed:R1=%d", or_0_out);
 assign and_0_out = not_0_out & DflipFlop_1_Q;
 DflipFlop DflipFlop_0(DflipFlop_0_Q, DflipFlop_0_Q_inv, clk_0, and_0_out, Ground_0_out,
Ground_0_out, Power_0_out);

 always @ (*)
 $display("DigitalLed:A2=%d", DflipFlop_0_Q);
 assign not_0_out = ~Button_0_out;
 assign Power_0_out = ~1'b0;
 assign Ground_0_out = 1'b0;
endmodule
